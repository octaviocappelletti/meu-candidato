# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# Obtenha em: app.supabase.com -> seu projeto -> Settings -> API

# URL do projeto (aba "Project URL")
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Service Role Key (aba "Project API keys" -> service_role)
# ATENCAO: esta chave tem acesso total ao banco. Use APENAS nos scripts Python.
# Nunca coloque no front-end nem commite no Git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
