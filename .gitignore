# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados do TSE (gerados pelo pipeline de ingestão)
data/output/*.json
data/output/*.csv
data/output/**/*.json
data/output/**/*.csv

# cache de downloads do TSE
data/.cache/

# fotos de candidatos (cache local — servir via CDN em produção)
public/fotos/*.jpg
public/fotos/*.jpeg
public/fotos/*.png
public/fotos/*.webp

# Python
data/scripts/__pycache__/
data/scripts/*.pyc
data/scripts/.venv/
